# ==============================================================================
# Leddro Environment Configuration Template
# Copy this file to .env and configure your local or cloud providers.
# DO NOT COMMIT YOUR REAL .env FILE WITH SECRETS TO GIT.
# ==============================================================================

# Core Application Settings
APP_NAME="Leddro Website Audit & Prospect Intelligence Engine"
APP_VERSION="1.0.0"
# Database Settings
# Local SQLite (default): "sqlite:///./leddro.db"
# Cloud PostgreSQL (Neon / Supabase): "postgresql://user:password@ep-...neon.tech/neondb?sslmode=require"
DATABASE_URL="sqlite:///./leddro.db"

# Active AI Provider: "gemini" | "openai" | "anthropic" | "compatible"
# Choose ONE active provider for draft generation.
AI_PROVIDER="gemini"

# Google Gemini Configuration (Free tier via Google AI Studio)
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"

# OpenAI Configuration
# Get an API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"

# Anthropic Claude Configuration
# Get an API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-haiku-20241022"
ANTHROPIC_BASE_URL="https://api.anthropic.com/v1"

# OpenAI-Compatible / Local Provider Configuration
# Works with Ollama (http://localhost:11434/v1), vLLM, LocalAI, OpenRouter, etc.
# For local Ollama, no API key is required.
COMPATIBLE_API_KEY=""
COMPATIBLE_MODEL="llama3"
COMPATIBLE_BASE_URL="http://localhost:11434/v1"

# AI Generation Safety & Timeouts
AI_REQUEST_TIMEOUT=30.0
AI_MAX_OUTPUT_TOKENS=1000

# Developer Profile Defaults (Used for email sign-off and context)
DEV_NAME="Alex Morgan"
DEV_TITLE="Independent Web Consultant & Full-Stack Developer"
DEV_SERVICES="Website performance tuning, modern responsive redesigns, SSL/DNS remediation, and technical SEO"
DEV_PORTFOLIO_URL=""
DEV_EMAIL="consultant@example.com"
DEV_SIGNATURE="Best regards,\nAlex Morgan\nIndependent Web Consultant"

# Google Cloud OAuth 2.0 & Gmail API Integration (Phase 6)
# Follow instructions in README.md to configure your Google Cloud Console project.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/google/callback"
GOOGLE_OAUTH_SCOPES="https://www.googleapis.com/auth/userinfo.email,https://www.googleapis.com/auth/gmail.send"
FRONTEND_URL="http://localhost:5173"
# Optional: 32-urlsafe base64-encoded key for Fernet at-rest credential encryption.
# If left empty, Leddro automatically generates and persists a key in .leddro_encryption_key
CREDENTIAL_ENCRYPTION_KEY=""

# Discovery Settings
OSM_OVERPASS_URL="https://overpass-api.de/api/interpreter"
OSM_NOMINATIM_URL="https://nominatim.openstreetmap.org/search"
OSM_USER_AGENT="LeddroBusinessDiscovery/1.0 (+https://github.com/leddro/leddro; contact@leddro.local)"
GOOGLE_PLACES_API_KEY=""
